
# StockroomER - Ejemplo de configuracion para produccion
# No colocar contrasenas reales en este archivo.

DJANGO_SETTINGS_MODULE=config.production_settings

STOCKROOM_SECRET_KEY=REEMPLAZAR_CON_CLAVE_SEGURA
STOCKROOM_ALLOWED_HOSTS=192.168.1.100

STOCKROOM_DB_NAME=stockroomer
STOCKROOM_DB_USER=stockroomer_app
STOCKROOM_DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_SEGURA
STOCKROOM_DB_HOST=127.0.0.1
STOCKROOM_DB_PORT=5432

STOCKROOM_HTTPS_ENABLED=false
STOCKROOM_CSRF_TRUSTED_ORIGINS=https://stockroomer.ejemplo.local
